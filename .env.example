WORDSHIELD_DATA_DIR=/path/to/private/wordshield-data
WORDSHIELD_KEYCHAIN_PATH=/Library/Keychains/System.keychain
WORDSHIELD_ALLOWED_USER=your-login@example.com
WORDSHIELD_TRUST_TAILSCALE_HEADERS=true
WORDSHIELD_LM_BASE_URL=http://127.0.0.1:1234/v1
WORDSHIELD_LM_TOKEN=PASTE_LM_STUDIO_TOKEN
WORDSHIELD_LM_MODEL=qwen/qwen3-14b
WORDSHIELD_PRIVACY_CHECKPOINT=/path/to/local/privacy-filter
WORDSHIELD_PRIVACY_DEVICE=cpu
WORDSHIELD_PRIVACY_REQUIRED=true
WORDSHIELD_QWEN_REQUIRED=true
WORDSHIELD_RENDER_REQUIRED=true
WORDSHIELD_LIBREOFFICE=/Applications/LibreOffice.app/Contents/MacOS/soffice
WORDSHIELD_RETENTION_DAYS=90
WORDSHIELD_UPLOAD_TTL_HOURS=24
