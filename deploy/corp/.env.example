WORDSHIELD_PUBLIC_URL=https://wordshield.example.internal:8443
# Use the UID/GID of the dedicated, unprivileged Linux service account.
APP_UID=10001
APP_GID=10001
HTTPS_PORT=8443
PRIVATE_SUBNET=172.30.74.0/24
PROXY_IP=172.30.74.10
GPU_ID=0
# Leave issuer empty for the initial synthetic pilot with local accounts.
WORDSHIELD_OIDC_ISSUER=
WORDSHIELD_OIDC_CLIENT_ID=
WORDSHIELD_OIDC_USER_GROUP=WordShield Users
WORDSHIELD_OIDC_ADMIN_GROUP=WordShield Admins
WORDSHIELD_OIDC_GROUP_CLAIM=groups
